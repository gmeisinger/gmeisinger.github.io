---
import Layout from "../layouts/Layout.astro";
---

<Layout title="George Meisinger">
  <main>
    <section class="portfolio-block block-intro" style="padding-bottom: 20px;">
      <div class="container">
        <img src="/img/player_idle.gif" class="img-rounded" />
        <div class="terminal-block intro-box" style="max-width: 980px;">
          <div class="terminal-block-header">
            <span class="prompt-symbol">$</span> cat about.txt
          </div>
          <div class="terminal-block-body">
            <p>
              Hello! I'm <strong>George Meisinger</strong>. I am a software
              designer and developer. I have a passion for video games, pixel art
              and music!
            </p>
            <p>Check out my games and projects below!</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <section class="gif-display" style="padding-top: 10px;">
    <div class="container">
      <div class="gif-row">
        <img src="/img/dog.gif" />
        <img src="/img/detective.gif" />
        <img src="/img/swordsman.gif" />
      </div>
    </div>
  </section>

  <section class="project-gallery" id="project-gallery">
    <div class="container">
      <div class="heading" style="text-align: center;">
        <h2 style="font-size: 5vw;">PROJECTS</h2>
      </div>
      <div class="row">
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">walljumper.p8</span>
            </div>
            <a href="/projects/walljumper">
              <img
                class="card-img-top scale-on-hover"
                src="/img/covers/walljumper.p8.png"
                alt="Walljumper screenshot"
              /></a
            >
            <div class="card-body">
              <h4><a href="/projects/walljumper">Walljumper</a></h4>
              <p class="text-muted card-text">Platformer made with Pico-8</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">psychedelic_jam.sh</span>
            </div>
            <a href="/projects/psychedelicjam"
              ><img
                class="card-img-top scale-on-hover"
                src="/img/covers/psychedelic.png"
                alt="Psychedelic Jam screenshot"
              /></a
            >
            <div class="card-body">
              <h4>
                <a href="/projects/psychedelicjam">Psychedelic Jam Entry</a>
              </h4>
              <p class="text-muted card-text">
                Platformer for Psychedelic Jam 2021
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">resume_v3.js</span>
            </div>
            <a href="/projects/resume"
              ><img
                class="card-img-top scale-on-hover"
                src="/img/covers/resume_logo.png"
                alt="Interactive Resume screenshot"
              /></a
            >
            <div class="card-body">
              <h4>
                <a href="/projects/resume">Interactive Resume</a>
              </h4>
              <p class="text-muted card-text">
                An interactive resume made in Phaser 3
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">dad_broke_moon.bin</span>
            </div>
            <a href="/projects/dadbrokethemoon"
              ><img
                class="card-img-top scale-on-hover"
                src="/img/covers/dadbrokethemoon.png"
                alt="Dad Broke The Moon screenshot"
              /></a
            >
            <div class="card-body">
              <h4>
                <a href="/projects/dadbrokethemoon">Dad Broke The Moon!</a>
              </h4>
              <p class="text-muted card-text">
                Entry for Global Game Jam 2020. Fix the moon in this vertical
                platformer!
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">hunter16.rom</span>
            </div>
            <a href="/projects/hunter16">
              <img
                class="card-img-top scale-on-hover"
                src="/img/covers/title_image3.png"
                alt="Hunter 16 screenshot"
              />
            </a>
            <div class="card-body">
              <h4><a href="/projects/hunter16">Hunter 16</a></h4>
              <p class="text-muted card-text">
                Master the bow and hunt all 7 Legendary Birds!
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">lyre_of_truth.dat</span>
            </div>
            <a href="/projects/lyreoftruth"
              ><img
                class="card-img-top scale-on-hover"
                src="/img/covers/lyre_of_truth_itch_cover.gif"
                alt="The Lyre of Truth screenshot"
              /></a
            >
            <div class="card-body">
              <h4>
                <a href="/projects/lyreoftruth">The Lyre of Truth</a>
              </h4>
              <p class="text-muted card-text">
                Entry for Community Game Jam 2019. Theme: "The game is a liar".
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">smash_smash.exe</span>
            </div>
            <a href="/projects/smashsmash"
              ><img
                class="card-img-top scale-on-hover"
                src="/img/covers/SMASHSMASH_title.gif"
                alt="Smash Smash screenshot"
              /></a
            >
            <div class="card-body">
              <h4><a href="/projects/smashsmash">Smash Smash!</a></h4>
              <p class="text-muted card-text">
                Smash all the rocks! Find treasure and avoid the dangerous
                dinos!
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">we_lost_jason.sh</span>
            </div>
            <a href="/projects/welostjason"
              ><img
                class="card-img-top scale-on-hover"
                src="/img/covers/cover.png"
                alt="We Lost Jason screenshot"
              /></a
            >
            <div class="card-body">
              <h4>
                <a href="/projects/welostjason">We Lost Jason!</a>
              </h4>
              <p class="text-muted card-text">
                Entry for The Maturity Explained J-Horror Jam 2019. Find your
                friend Jason in this spooky adventure!
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">strange_patterns.gd</span>
            </div>
            <a href="/projects/strangepatterns">
              <img
                class="card-img-top scale-on-hover"
                src="/img/covers/StrangePatterns.png"
                alt="Strange Patterns screenshot"
              />
            </a>
            <div class="card-body">
              <h4>
                <a href="/projects/strangepatterns">Strange Patterns</a>
              </h4>
              <p class="text-muted card-text">
                A visual tool written with the Godot engine.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">scitalk.py</span>
            </div>
            <img
              class="card-img-top scale-on-hover"
              src="/img/covers/scitalk.png"
              alt="SCITalk screenshot"
            />
            <div class="card-body">
              <h4>SCITalk</h4>
              <p class="text-muted card-text">
                Conversational AI that answers questions about COVID-19 data.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 col-lg-4">
          <div class="card">
            <div class="card-titlebar">
              <span class="titlebar-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </span>
              <span class="titlebar-text">derelict.wip</span>
            </div>
            <a href="/projects/derelict">
              <img
                class="card-img-top scale-on-hover"
                src="/img/covers/derelict.png"
                alt="Derelict screenshot"
              />
            </a>
            <div class="card-body">
              <h4><a href="/projects/derelict">Derelict (WIP)</a></h4>
              <p class="text-muted card-text">
                Top down shooter made in Godot engine.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
