---
import Layout from "../layouts/Layout.astro";
---

<Layout title="George Meisinger - Resume">
  <div class="terminal-block" id="resume-link">
    <div class="terminal-block-header">
      <span class="prompt-symbol">$</span> download resume.pdf
    </div>
    <div class="terminal-block-body" style="text-align: center;">
      <a href="/RESUME.pdf">Download the PDF</a>
    </div>
  </div>

  <div class="terminal-block" id="interactive-resume-link">
    <div class="terminal-block-header">
      <span class="prompt-symbol">$</span> run resume --interactive
    </div>
    <div class="terminal-block-body" style="text-align: center;">
      <a href="/projects/resume">Interactive Resume (JavaScript)</a>
    </div>
  </div>
</Layout>
