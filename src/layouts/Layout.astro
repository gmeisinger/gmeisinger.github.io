---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
    />
    <title>{title}</title>
    <link
      href="https://unpkg.com/nes.css@2.2.0/css/nes.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css?family=Press+Start+2P"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <div class="container">
        <div class="nav-brand">
          <a href="/"> <h1><img src="" /></h1>_George Meisinger</a>
        </div>
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item">
            <a class="nav-link" href="/resume">Resume</a>
          </li>
        </ul>
        <div class="social-buttons">
          <!-- <p>Follow Me</p> -->
          <div class="share">
            <a href="https://github.com/gmeisinger" target="_blank"
              ><i class="nes-icon github is-dark"></i></a
            >
          </div>
        </div>
      </div>
    </header>

    <div id="page">
      <main class="container">
        <slot />
      </main>
    </div>

    <footer class="page-footer" style="text-align: center;">
      <div class="container">
        <p>George Meisinger 2020</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --background-color: #1a1a2e;
    --primary-color: #0f3460;
    --secondary-color: #e94560;
    --accent-color: #16213e;
    --font-color: #ffffff;
    --glow-color: #00ffff;
  }

  body,
  code,
  html,
  kbd,
  pre,
  samp {
    font-family: "Press Start 2P", cursive;
  }

  html {
    cursor: auto;
  }

  body {
    background-color: var(--background-color);
    color: var(--font-color);
    background-image: linear-gradient(rgba(0, 0, 0, 0.5) 50%, transparent 50%);
    background-size: 100% 4px;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--secondary-color);
    text-shadow: 0 0 5px var(--secondary-color);
  }

  a,
  button {
    color: var(--font-color);
    text-shadow: 0 0 5px var(--glow-color);
    cursor: pointer;
    text-decoration: none;
  }

  a:hover,
  button:hover {
    color: var(--secondary-color);
  }

  .container {
    margin: auto;
    max-width: 980px;
    padding: 0 1rem;
  }

  header {
    background-color: var(--accent-color);
    border-bottom: 4px solid var(--primary-color);
    padding: 1rem 0;
    margin-bottom: 2rem;
  }

  header .container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    /* allow items to wrap on narrow viewports so they don't overflow */
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .nav-brand a {
    color: var(--font-color);
    text-decoration: none;
    font-size: 1.5rem;
  }

  /* make sure flex children can shrink (prevents overflow on mobile) */
  .nav-brand,
  .navbar-nav,
  .social-buttons {
    min-width: 0;
  }

  .navbar-nav {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    /* prefer gap over margin for more consistent wrapping behavior */
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-item {
    /* remove large left margins so items can wrap without causing horizontal scroll */
    margin-left: 0;
  }

  .nav-link {
    font-size: 1rem;
  }

  .social-buttons {
    text-align: right;
  }

  /* Mobile / small devices: stack header items and center them */
  @media (max-width: 600px) {
    header .container {
      align-items: center;
      padding: 0.5rem 0;
    }

    .nav-brand {
      order: 1;
      width: 100%;
      text-align: center;
    }

    .navbar-nav {
      order: 2;
      width: 100%;
      justify-content: center;
      margin-top: 0.5rem;
    }

    .social-buttons {
      order: 3;
      width: 100%;
      text-align: center;
      margin-top: 0.25rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }
  }

  .social-buttons p {
    margin-bottom: 0.5rem;
  }

  .nes-icon.github.is-dark {
    filter: invert(1);
  }

  main.container {
    background-color: var(--accent-color);
    padding: 2rem;
    border: 4px solid var(--primary-color);
  }

  .page-footer {
    margin-top: 2rem;
    padding: 1rem;
    border-top: 4px solid var(--primary-color);
  }

  section {
    padding-top: 40px;
    padding-bottom: 10px;
  }

  .project-page {
    max-width: 90%;
    margin: auto;
  }

  .card {
    padding-top: 8px;
    padding-bottom: 8px;
    justify-content: center;
    /* enable smooth elevation on hover */
    transition:
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform, box-shadow;
  }

  .card-body {
    text-align: center;
  }

  .card-img-top {
    width: 100%;
    height: 234px;
    object-fit: contain;
    padding-bottom: 8px;
  }

  /* Slight image scale when the card is hovered */
  .scale-on-hover {
    display: block; /* ensure transform affects layout predictably */
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transform-origin: center center;
  }

  /* Apply elevation only on devices that support hover (avoids interfering with touch scrolling) */
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-8px);
      box-shadow:
        0 12px 28px rgba(0, 0, 0, 0.45),
        0 4px 8px rgba(0, 0, 0, 0.25);
      z-index: 3; /* lift above neighbors */
    }

    .card:hover .card-img-top,
    .card:hover .scale-on-hover {
      transform: scale(1.03);
    }

    .card:active {
      transform: translateY(-4px);
      transform: translateX(-2px);
    }
  }

  /* Keyboard accessibility: show elevation when focused via keyboard */
  .card:focus-within {
    transform: translateY(-6px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
  }

  #resume-link,
  #interactive-resume-link {
    padding-top: 20px;
    padding-bottom: 20px;
    max-width: 400px;
    margin: 20px auto;
  }

  .portfolio-block {
    padding-top: 100px;
  }

  .portfolio-block.block-intro {
    text-align: center;
  }

  .intro-box {
    background-image: linear-gradient(rgba(0, 0, 0, 0.5) 50%, transparent 50%);
    background-size: 100% 4px;
    background-color: var(--background-color);
  }

  /* GIF row: stack on small screens, align in a row on larger screens */
  .gif-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .gif-row img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Subtle entrance animation: fade up and appear with a slight stagger */
  @keyframes fadeUpIn {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.995);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Respect user preference for reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .gif-row img {
      opacity: 0;
      transform: translateY(8px) scale(0.995);
      animation: fadeUpIn 420ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    .gif-row img:nth-child(1) {
      animation-delay: 0ms;
    }

    .gif-row img:nth-child(2) {
      animation-delay: 80ms;
    }

    .gif-row img:nth-child(3) {
      animation-delay: 160ms;
    }
  }

  @media (min-width: 700px) {
    .gif-row {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }

    .gif-row img {
      max-width: 220px;
    }
  }

  /* Responsive grid utilities used by index cards */
  .row {
    display: flex;
    flex-wrap: wrap;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
    gap: 1rem 0;
  }

  /* make column children use border-box sizing and horizontal padding */
  .row > [class*="col-"] {
    box-sizing: border-box;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  /* Mobile-first: full width columns */
  .col-xs-12 {
    flex: 0 0 100%;
    max-width: 100%;
  }

  /* Small screens: two columns */
  @media (min-width: 576px) {
    .col-sm-6 {
      flex: 0 0 50%;
      max-width: 50%;
    }
  }

  /* Medium+ screens: three columns */
  @media (min-width: 768px) {
    .col-md-4,
    .col-lg-4 {
      flex: 0 0 33.3333%;
      max-width: 33.3333%;
    }
  }

  /* extra-specific fallback in case other styles override column widths */
  @media (min-width: 768px) {
    .row > .col-md-4 {
      flex-basis: 33.3333% !important;
      max-width: 33.3333% !important;
    }
  }
</style>
